# Supabase PostgreSQL (Dashboard > Connect). Copy this file to .env and fill in real values.
# The URL MUST start with jdbc:  (the dashboard shows postgresql://..., add "jdbc:" in front).
#
# Direct connection (needs IPv6 or the IPv4 add-on):
#   SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
#   SUPABASE_DB_USER=postgres
# Session pooler (works on IPv4-only networks). Copy host/user from Dashboard > Connect > Session pooler:
#   SUPABASE_DB_URL=jdbc:postgresql://aws-X-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
#   SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Supabase Storage (image uploads) - backend only, never put these in frontend JavaScript
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Dashboard > Settings > API Keys > Secret keys (sb_secret_...). NOT the publishable key.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_KEY
SUPABASE_STORAGE_BUCKET=wardrobe-images

# AI clothing recognition (category / colour / pattern) - backend only.
# Free key: https://aistudio.google.com/apikey . Leave empty to fill in details manually.
GEMINI_API_KEY=
# Optional. Any Gemini model that accepts images, e.g. gemini-flash-lite-latest for a larger free quota.
GEMINI_MODEL=gemini-flash-latest

# Garment extraction (Beautify) with SAM 3 via Roboflow - backend only.
# Free key: https://app.roboflow.com -> Settings -> API Keys. Leave empty to use the on-device model.
ROBOFLOW_API_KEY=
